{
  "name": "call-answer-server",
  "version": "0.1.0",
  "private": true,
  "description": "Exotel AgentStream WebSocket server for Call-Answer",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "simulate": "tsx --env-file-if-exists=.env scripts/simulate.ts"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
