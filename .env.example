# Port the server listens on (plain HTTP + WebSocket; TLS is terminated in front).
PORT=8080
# Public hostname Exotel reaches, without scheme. Used in the wss:// URL returned by /exotel/resolve.
PUBLIC_HOST=agent.example.com
# basic = require HTTP Basic credentials from Exotel; none = skip (Call_Token still applies).
AUTH_MODE=basic
EXOTEL_BASIC_USER=exotel
EXOTEL_BASIC_PASSWORD=change-me
# HMAC secret for call tokens. Generate: openssl rand -hex 32
CALL_TOKEN_SECRET=change-me-to-a-long-random-value
# Stream sample rate: 8000, 16000 or 24000.
SAMPLE_RATE=8000
# Handler to use for calls. Phase 1: echo.
HANDLER=echo
# Echo chunk size in bytes: multiple of 320, 3200..100000.
ECHO_CHUNK_BYTES=3200
# true allows ECHO_CHUNK_BYTES below 3200 (to measure Exotel behaviour).
ALLOW_SMALL_CHUNKS=false
# End a call if no media arrives for this many seconds.
MEDIA_TIMEOUT_SECONDS=10
# Optional folder for per-call <callSid>.jsonl frame logs.
FRAME_LOG_DIR=
# true writes inbound audio to <callSid>.pcm in FRAME_LOG_DIR. Privacy: keep false unless measuring.
RECORD_RAW_AUDIO=false
# debug, info, warn, error
LOG_LEVEL=info
# Concurrent call cap. Set from instance size.
MAX_CONCURRENT_CALLS=20
# Seconds active calls may finish after SIGTERM.
SHUTDOWN_GRACE_SECONDS=120
